  source_code_uri: https://github.com/ruby/json
rdoc_options:
- "--title"
- JSON implementation for Ruby
- "--main"
- README.md
require_paths:
- lib
required_ruby_version: !ruby/object:Gem::Requirement
  requirements:
  - - ">="
